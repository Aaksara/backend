DJANGO_SECRET_KEY=change-me   # required when DJANGO_DEBUG=false
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local (non-Docker) run; docker-compose overrides these two.
DATABASE_URL=postgres://bookx:bookx@localhost:5434/bookx
# REDIS_URL=redis://localhost:6379/0   # unset = in-memory channel layer (single process)

# Only these email domains (and their subdomains) may register.
UNIVERSITY_EMAIL_DOMAINS=university.edu

# The Next.js frontend (email links, CORS and WebSocket origin checks).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Reverse proxies in front of Django (e.g. 1 behind nginx), so rate limits see the client IP.
NUM_PROXIES=0

# Production HTTPS hardening (only applied when DJANGO_DEBUG=false)
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Email (console backend prints emails to the server log in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BookX <no-reply@university.edu>
