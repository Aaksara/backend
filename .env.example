# Local development. On Vercel, set these in Project Settings -> Environment Variables.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Vercel: your API domain, e.g. aksara-api.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local: docker compose up -d db. Production: the Prisma Postgres *direct* URL
# (postgres://...@db.prisma.io:5432/postgres?sslmode=require), not prisma+postgres://.
DATABASE_URL=postgres://aksara:aksara@localhost:5434/aksara

# The Next.js frontend: email links and CORS. Vercel: https://<your-frontend>.vercel.app
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Only these email domains (and their subdomains) may register.
UNIVERSITY_EMAIL_DOMAINS=university.edu

# Uploaded images. Leave empty locally (files go to media/). Vercel needs a bucket:
# any S3-compatible storage. Supabase (public bucket):
#   AWS_S3_ENDPOINT_URL=https://<project>.supabase.co/storage/v1/s3
#   AWS_S3_REGION_NAME=<region shown in Supabase>
#   AWS_S3_CUSTOM_DOMAIN=<project>.supabase.co/storage/v1/object/public/<bucket>
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# Shared cache for rate limits (e.g. Upstash Redis: rediss://...). Recommended on Vercel.
REDIS_URL=
# Vercel puts the client IP in X-Forwarded-For: set 1 there, 0 locally.
NUM_PROXIES=0

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Emails are printed in the terminal locally. Production: SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AKSARA <no-reply@university.edu>
