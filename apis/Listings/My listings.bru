meta {
  name: My listings
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/listings/mine/
  body: none
  auth: none
}

docs {
  All of the signed-in user's listings, in every status.

  Paginated: `?page=` and `?page_size=` (max 100). Response:
  `{ "count": n, "next": url|null, "previous": url|null, "results": [...] }`
}
