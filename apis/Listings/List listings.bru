meta {
  name: List listings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/listings/?ordering=price
  body: none
  auth: none
}

params:query {
  ~search: algorithms
  ~isbn: 9780262033848
  ~course_code: CS101
  ~condition: good
  ~listing_type: sell
  ~max_price: 30
  ordering: price
}

docs {
  Browse listings. Without `status`, only `available` ones are shown. Withdrawn listings are
  only visible to their seller.

  Filters: `search` (title, authors, ISBN, course code, description), `isbn`, `title`,
  `author`, `course_code`, `condition`, `listing_type`, `status` (repeat the param for
  several values), `min_price`, `max_price`, `book`, `seller`, `preferred_location`.
  `ordering`: `price`, `-price`, `created_at`, `-created_at`.

  Paginated: `?page=` and `?page_size=` (max 100). Response:
  `{ "count": n, "next": url|null, "previous": url|null, "results": [...] }`
}
