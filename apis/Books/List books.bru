meta {
  name: List books
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/books/?search=algorithms
  body: none
  auth: none
}

params:query {
  search: algorithms
  ~ordering: -available_listings
  ~published_year: 2009
}

docs {
  Search and browse the catalogue.

  - `search`: title, subtitle, authors, ISBN or publisher
  - `ordering`: `title`, `published_year`, `available_listings`, `lowest_price` (prefix `-` to reverse)
  - `published_year`: exact year

  Paginated: `?page=` and `?page_size=` (max 100). Response:
  `{ "count": n, "next": url|null, "previous": url|null, "results": [...] }`
}
