meta {
  name: Start conversation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/conversations/
  body: json
  auth: none
}

body:json {
  {
    "listing": {{listingId}}
  }
}

script:post-response {
  if (res.status < 300) bru.setVar("conversationId", res.body.id);
}

docs {
  Open a chat with a listing's seller (not on your own or a withdrawn listing).

  - `201` new conversation, or `200` if you already have one for this listing.
    Conversation: `id, listing_detail {id, book, price, listing_type, status}, buyer, seller,
}
