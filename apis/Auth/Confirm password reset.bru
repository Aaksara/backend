meta {
  name: Confirm password reset
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/auth/password/reset/confirm/
  body: json
  auth: none
}

body:json {
  {
    "uid": "{{uid}}",
    "token": "{{token}}",
    "new_password": "An0ther-good-pass"
  }
}

docs {
  Public. `uid` and `token` come from the reset email. Revokes every session.

  - `200 {"detail": "Password has been reset."}`
  - `400 {"detail": "Invalid or expired link."}` or `{"new_password": [...]}`
}
