meta {
  name: Request password reset
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/password/reset/
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  Public. Emails a link to `{FRONTEND_URL}/reset-password?uid=...&token=...`. Always `200`
  with the same message, whether or not the account exists.
}
