meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register/
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "full_name": "Test Student",
    "password": "{{password}}"
  }
}

docs {
  Public. Only emails on `UNIVERSITY_EMAIL_DOMAINS` (or their subdomains) are accepted.
  Sends a verification email (printed in the server log in development).

  Required: `email`, `full_name`, `password`. Optional: `student_id`, `department`, `phone`.

  - `201` the new user (without the password)
  - `400` field errors, e.g. `{"email": ["An account with this email already exists."]}`
}
