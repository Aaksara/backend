meta {
  name: Verify email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-email/
  body: json
  auth: none
}

body:json {
  {
    "uid": "{{uid}}",
    "token": "{{token}}"
  }
}

docs {
  Public. `uid` and `token` come from the link in the verification email
  (`{FRONTEND_URL}/verify-email?uid=...&token=...`). The link works once.

  - `200 {"detail": "Email verified. You can now log in."}`
  - `400 {"detail": "Invalid or expired link."}`
}
