post {
  url: {{baseUrl}}/api/exchanges/{{exchangeId}}/complete/
  body: none
  auth: none
}

docs {
  Either party, once `accepted` and the books have changed hands. Marks the books
  `completed` and rejects every other pending request for them.

  - `200` the exchange
}
